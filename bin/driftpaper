#!/usr/bin/env python3
"""Driftpaper: keep a library of static + live wallpapers, apply per screen on Plasma."""
import json, shutil, subprocess, sys
from pathlib import Path

from PySide6.QtCore import QSize, Qt
from PySide6.QtGui import QIcon, QPixmap
from PySide6.QtWidgets import (QApplication, QCheckBox, QComboBox, QFileDialog, QHBoxLayout, QLabel, QListView,
                               QListWidget, QListWidgetItem, QMessageBox, QPushButton, QVBoxLayout, QWidget)

LIB = Path.home() / ".local/share/driftpaper/library"
THUMBS = LIB.parent / "thumbs"
IMAGES = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".avif"}
VIDEOS = {".mp4", ".webm", ".mkv", ".mov", ".gif"}  # gif gets converted to mp4 on import
LIVE_PLUGIN, IMAGE_PLUGIN = "org.driftpaper.livewall", "org.kde.image"


def plasma(script: str) -> str:
    r = subprocess.run(["qdbus-qt6", "org.kde.plasmashell", "/PlasmaShell", "org.kde.PlasmaShell.evaluateScript", script],
                       capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or "plasmashell not reachable")
    return r.stdout.strip()


def screens() -> list[int]:
    out = plasma('var o=[];desktops().forEach(function(d){o.push(d.screen)});print(o.join(" "))')
    return sorted({int(x) for x in out.split()})


def make_thumb(src: Path) -> Path:
    dst = THUMBS / (src.stem + ".jpg")
    if src.suffix.lower() in IMAGES:
        QPixmap(str(src)).scaled(320, 180, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation).save(str(dst), "JPG")
    else:
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-strict", "unofficial", "-ss", "1", "-i", str(src), "-frames:v", "1",
                        "-vf", "scale=320:180:force_original_aspect_ratio=increase,crop=320:180", str(dst)])
        if not dst.exists():  # clip shorter than 1s
            subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-strict", "unofficial", "-i", str(src), "-frames:v", "1",
                            "-vf", "scale=320:180:force_original_aspect_ratio=increase,crop=320:180", str(dst)])
    return dst


def import_file(src: Path) -> Path:
    ext = src.suffix.lower()
    dst = LIB / src.name
    n = 1
    while dst.exists():
        dst = LIB / f"{src.stem}-{n}{src.suffix}"; n += 1
    if ext == ".gif":  # QtMultimedia can't play gif; re-encode to a loopable mp4
        dst = dst.with_suffix(".mp4")
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(src), "-movflags", "faststart", "-pix_fmt",
                        "yuv420p", "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2", str(dst)], check=True)
    else:
        shutil.copy2(src, dst)
    make_thumb(dst)
    return dst


class Studio(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Driftpaper")
        self.resize(900, 620)
        self.setAcceptDrops(True)
        LIB.mkdir(parents=True, exist_ok=True); THUMBS.mkdir(parents=True, exist_ok=True)

        self.grid = QListWidget(viewMode=QListView.IconMode, iconSize=QSize(240, 135), resizeMode=QListView.Adjust,
                                movement=QListView.Static, spacing=10, wordWrap=True)
        self.grid.itemDoubleClicked.connect(lambda _: self.apply())

        add, rm, ap = QPushButton("Add…"), QPushButton("Remove"), QPushButton("Apply")
        add.clicked.connect(self.add); rm.clicked.connect(self.remove); ap.clicked.connect(self.apply)
        ap.setDefault(True)
        self.target = QComboBox(); self.target.addItem("All screens", None)
        try:
            for s in screens():
                self.target.addItem(f"Screen {s + 1}", s)
        except Exception:  # plasmashell unreachable: library still usable, apply will report
            pass
        self.pause_max = QCheckBox("Pause live when a window is maximized"); self.pause_max.setChecked(True)
        self.pause_bat = QCheckBox("Pause live on battery"); self.pause_bat.setChecked(True)
        self.msg = QLabel("Double-click a wallpaper to apply. Drop files here to add.")

        bar = QHBoxLayout()
        for w in (add, rm): bar.addWidget(w)
        bar.addStretch(); bar.addWidget(QLabel("Apply to:")); bar.addWidget(self.target); bar.addWidget(ap)
        opts = QHBoxLayout(); opts.addWidget(self.pause_max); opts.addWidget(self.pause_bat); opts.addStretch()
        lay = QVBoxLayout(self)
        lay.addLayout(bar); lay.addWidget(self.grid); lay.addLayout(opts)
        lay.addWidget(self.msg)
        self.reload()

    def reload(self):
        self.grid.clear()
        for f in sorted(LIB.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True):
            if f.suffix.lower() not in IMAGES | VIDEOS:
                continue
            thumb = THUMBS / (f.stem + ".jpg")
            if not thumb.exists():
                make_thumb(f)
            live = f.suffix.lower() in VIDEOS
            it = QListWidgetItem(QIcon(str(thumb)), ("▶ " if live else "") + f.stem)
            it.setData(Qt.UserRole, str(f)); it.setSizeHint(QSize(260, 175))
            self.grid.addItem(it)

    def ingest(self, paths):
        bad = []
        for p in map(Path, paths):
            if p.suffix.lower() not in IMAGES | VIDEOS:
                bad.append(p.name); continue
            try:
                import_file(p)
            except Exception as e:
                bad.append(f"{p.name} ({e})")
        self.reload()
        if bad:
            QMessageBox.warning(self, "Skipped", "\n".join(bad))

    def add(self):
        paths, _ = QFileDialog.getOpenFileNames(self, "Add wallpapers", str(Path.home() / "Pictures"),
                                                "Media (*.jpg *.jpeg *.png *.webp *.bmp *.avif *.mp4 *.webm *.mkv *.mov *.gif)")
        self.ingest(paths)

    def dragEnterEvent(self, e):
        if e.mimeData().hasUrls(): e.acceptProposedAction()

    def dropEvent(self, e):
        self.ingest([u.toLocalFile() for u in e.mimeData().urls() if u.isLocalFile()])

    def remove(self):
        it = self.grid.currentItem()
        if not it: return
        f = Path(it.data(Qt.UserRole))
        if QMessageBox.question(self, "Remove", f"Delete {f.name} from the library?") == QMessageBox.Yes:
            f.unlink(missing_ok=True); (THUMBS / (f.stem + ".jpg")).unlink(missing_ok=True); self.reload()

    def apply(self):
        it = self.grid.currentItem()
        if not it:
            self.msg.setText("Select a wallpaper first."); return
        f = Path(it.data(Qt.UserRole))
        live = f.suffix.lower() in VIDEOS
        plugin = LIVE_PLUGIN if live else IMAGE_PLUGIN
        cfg = {"Video": f.as_uri(), "PauseMaximized": self.pause_max.isChecked(),
               "PauseOnBattery": self.pause_bat.isChecked()} if live else {"Image": f.as_uri()}
        screen = self.target.currentData()
        js = f"""
        var cfg = {json.dumps(cfg)}, only = {json.dumps(screen)};
        desktops().forEach(function(d) {{
            if (only !== null && d.screen !== only) return;
            d.wallpaperPlugin = {json.dumps(plugin)};
            d.currentConfigGroup = ["Wallpaper", {json.dumps(plugin)}, "General"];
            for (var k in cfg) d.writeConfig(k, cfg[k]);
            d.reloadConfig();
        }});"""
        try:
            plasma(js)
            self.msg.setText(f"Applied {'live' if live else 'static'} wallpaper: {f.name}")
        except Exception as e:
            self.msg.setText(f"Failed: {e}")


if __name__ == "__main__":
    app = QApplication(sys.argv)
    w = Studio(); w.show()
    sys.exit(app.exec())
